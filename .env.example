# Subvision Studio — Environment Configuration
# Copy this to .env and fill in your values

# ── Application ───────────────────────────────────────────────────
SVS_DEBUG=false
SVS_LOG_LEVEL=INFO
SVS_HOST=0.0.0.0
SVS_PORT=8000
SVS_CORS_ORIGINS=http://localhost,http://localhost:80,http://localhost:4200

# ── Database ──────────────────────────────────────────────────────
# SQLite (default, zero-config)
SVS_DATABASE_URL=sqlite+aiosqlite:///./subvision.db
# PostgreSQL (production)
# SVS_DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/subvision

# ── External Competition Event API ────────────────────────────────
# The URL of the pre-existing competition management API
SVS_EXTERNAL_API_URL=http://localhost:9000/api
SVS_EXTERNAL_API_POLL_INTERVAL_MS=100
SVS_EXTERNAL_API_TIMEOUT_S=5.0
SVS_EXTERNAL_API_KEY=

# ── OBS WebSocket ─────────────────────────────────────────────────
SVS_OBS_WEBSOCKET_URL=ws://localhost:4455
SVS_OBS_WEBSOCKET_PASSWORD=
SVS_OBS_ENABLED=true

# ── Realization Engine ────────────────────────────────────────────
SVS_DECISION_CYCLE_MS=50
SVS_MIN_DISPLAY_DURATION_MS=2000
SVS_DEFAULT_COOLDOWN_MS=3000
SVS_SCORE_THRESHOLD_SWITCH=60.0

# ── Video / Streaming ─────────────────────────────────────────────
SVS_VIDEO_SNAPSHOT_INTERVAL_MS=500
SVS_FFMPEG_PATH=ffmpeg

# ── Config ────────────────────────────────────────────────────────
SVS_CONFIG_DIR=./configs
SVS_DEFAULT_PROFILE=default
